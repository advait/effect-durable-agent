{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eda-host-conformance",
  "main": "cloudflare-worker.ts",
  "compatibility_date": "2026-07-29",
  "durable_objects": {
    "bindings": [
      {
        "name": "EDA_SESSION",
        "class_name": "EDAConformanceSession",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["EDAConformanceSession"],
    },
  ],
}
