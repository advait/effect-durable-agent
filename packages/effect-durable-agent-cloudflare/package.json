{
  "name": "effect-durable-agent-cloudflare",
  "version": "0.1.0-alpha.5",
  "description": "Cloudflare Durable Objects host for effect-durable-agent.",
  "keywords": [
    "agents",
    "cloudflare",
    "durable-objects",
    "effect",
    "event-sourcing"
  ],
  "homepage": "https://github.com/advait/effect-durable-agent#readme",
  "bugs": {
    "url": "https://github.com/advait/effect-durable-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advait/effect-durable-agent.git",
    "directory": "packages/effect-durable-agent-cloudflare"
  },
  "license": "MIT",
  "author": "Advait Shinde",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./durable-object": {
      "types": "./dist/durable-object.d.ts",
      "import": "./dist/durable-object.js"
    },
    "./durable-object-runtime": {
      "types": "./dist/durable-object-runtime.d.ts",
      "import": "./dist/durable-object-runtime.js"
    },
    "./durable-object-storage": {
      "types": "./dist/durable-object-storage.d.ts",
      "import": "./dist/durable-object-storage.js"
    },
    "./websocket-protocol": {
      "types": "./dist/websocket-protocol.d.ts",
      "import": "./dist/websocket-protocol.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "pnpm run lint && pnpm run typecheck",
    "lint": "vp fmt --check src testing package.json tsconfig.json vite.config.ts && vp lint --deny-warnings src testing vite.config.ts",
    "lint:fix": "vp fmt src testing package.json tsconfig.json vite.config.ts && vp lint --fix src testing vite.config.ts",
    "prepack": "vp pack --no-publint",
    "test": "vp test run --passWithNoTests src",
    "test:integration": "vp test run testing/integration/host-conformance.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "dependencies": {
    "effect-durable-agent": "workspace:*"
  },
  "peerDependencies": {
    "@effect/ai-openai": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.18.8",
    "@cloudflare/workers-types": "5.20260813.1",
    "@effect/ai-openai": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102",
    "vite-plus": "^0.1.21",
    "vitest": "^4.1.8"
  }
}
