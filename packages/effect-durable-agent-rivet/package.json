{
  "name": "effect-durable-agent-rivet",
  "version": "0.1.0-alpha.5",
  "description": "Rivet Actors host for effect-durable-agent.",
  "keywords": [
    "actors",
    "agents",
    "effect",
    "event-sourcing",
    "rivet"
  ],
  "homepage": "https://github.com/advait/effect-durable-agent#readme",
  "bugs": {
    "url": "https://github.com/advait/effect-durable-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advait/effect-durable-agent.git",
    "directory": "packages/effect-durable-agent-rivet"
  },
  "license": "MIT",
  "author": "Advait Shinde",
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./actor": {
      "types": "./dist/actor.d.ts",
      "import": "./dist/actor.js"
    },
    "./runtime": {
      "types": "./dist/runtime.d.ts",
      "import": "./dist/runtime.js"
    },
    "./storage": {
      "types": "./dist/storage.d.ts",
      "import": "./dist/storage.js"
    },
    "./websocket-protocol": {
      "types": "./dist/websocket-protocol.d.ts",
      "import": "./dist/websocket-protocol.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "pnpm run lint && pnpm run typecheck",
    "lint": "vp fmt --check src testing package.json tsconfig.json vite.config.ts && vp lint --deny-warnings src testing vite.config.ts",
    "lint:fix": "vp fmt src testing package.json tsconfig.json vite.config.ts && vp lint --fix src testing vite.config.ts",
    "prepack": "vp pack --no-publint",
    "test": "vp test run --passWithNoTests src",
    "test:integration": "vp test run testing/integration/host-conformance.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "dependencies": {
    "effect-durable-agent": "workspace:*",
    "rivetkit": "2.3.10"
  },
  "peerDependencies": {
    "@effect/ai-openai": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@effect/ai-openai": "4.0.0-beta.102",
    "@types/node": "^25.0.0",
    "effect": "4.0.0-beta.102",
    "vite-plus": "^0.1.21",
    "vitest": "^4.1.8",
    "ws": "^8.18.3"
  }
}
