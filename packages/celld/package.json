{
  "name": "effect-durable-agent-celld",
  "version": "0.1.0-alpha.4",
  "description": "celld host for effect-durable-agent.",
  "keywords": [
    "agents",
    "celld",
    "durable-objects",
    "effect",
    "event-sourcing"
  ],
  "homepage": "https://github.com/advait/effect-durable-agent#readme",
  "bugs": {
    "url": "https://github.com/advait/effect-durable-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advait/effect-durable-agent.git",
    "directory": "packages/celld"
  },
  "license": "MIT",
  "author": "Advait Shinde",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "pnpm run lint && pnpm run typecheck",
    "lint": "vp fmt --check src package.json tsconfig.json vite.config.ts && vp lint --deny-warnings src vite.config.ts",
    "lint:fix": "vp fmt src package.json tsconfig.json vite.config.ts && vp lint --fix src vite.config.ts",
    "prepack": "vp pack --no-publint",
    "test": "vp test run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "dependencies": {
    "effect-durable-agent": "workspace:*",
    "effect-durable-agent-cloudflare": "workspace:*"
  },
  "peerDependencies": {
    "@effect/ai-openai": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260813.1",
    "@effect/ai-openai": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102",
    "vite-plus": "^0.1.21",
    "vitest": "^4.1.8"
  }
}
