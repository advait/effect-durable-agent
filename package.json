      "types": "./dist/domain/message-transcript.d.ts",
      "import": "./dist/domain/message-transcript.js"
    },
    "./domain/reduced-state": {
      "types": "./dist/domain/reduced-state.d.ts",
      "import": "./dist/domain/reduced-state.js"
    },
