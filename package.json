    "./types/tracing": {
      "types": "./dist/types/tracing.d.ts",
      "import": "./dist/types/tracing.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "vp pack",
    "check": "pnpm run lint && pnpm run typecheck",
    "ci": "pnpm run check && pnpm run test",
    "lint": "vp fmt --check && vp lint",
    "lint:fix": "vp fmt && vp lint --fix",
    "package:check": "node scripts/check-package.mjs",
    "prepack": "pnpm run build",
    "release:check": "pnpm run ci && pnpm run build && pnpm run package:check",
    "test": "vp test run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "alpha"
  },
  "peerDependencies": {
    "@effect/ai-openai": "4.0.0-beta.102",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260727.1",
    "@effect/ai-openai": "4.0.0-beta.102",
    "@types/node": "^25.7.0",
    "effect": "4.0.0-beta.102",
    "fast-check": "^4.8.0",
    "oxlint": "1.63.0",
    "publint": "^0.3.22",
    "tsx": "4.21.0",
    "typescript": "^6.0.3",
    "vite-plus": "^0.1.21",
    "vitest": "^4.1.8"
  }
