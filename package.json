{
  "name": "effect-durable-agent",
  "version": "0.1.0-alpha.2",
  "description": "A Redux-inspired state-management and durable execution layer for agentic applications on Cloudflare Durable Objects.",
  "keywords": [
    "agents",
    "cloudflare",
    "durable-objects",
    "effect",
    "event-sourcing",
    "state-machine"
  ],
  "homepage": "https://github.com/advait/effect-durable-agent#readme",
  "bugs": {
    "url": "https://github.com/advait/effect-durable-agent/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/advait/effect-durable-agent.git"
  },
  "license": "MIT",
  "author": "Advait Shinde",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "packageManager": "pnpm@10.33.2",
